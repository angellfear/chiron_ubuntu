[Unit]
Description=Chiron OV13B10 camera ISP and 3A service
Requires=chiron-camera-modules.service
After=chiron-camera-modules.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/usr/lib/chiron-camera
Environment=LD_PRELOAD=/usr/lib/chiron-camera/libchiron-ov13b10.so
ExecStartPre=/usr/bin/sha256sum -c /usr/lib/chiron-camera/ov13b10-sdr.calib.sha256
ExecStartPre=/bin/sh -ec 'for i in $(seq 1 100); do [ -e /dev/media0 ] && exit 0; sleep 0.1; done; exit 1'
ExecStart=/usr/lib/chiron-camera/ispService -m /dev/media0 -M 2
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
