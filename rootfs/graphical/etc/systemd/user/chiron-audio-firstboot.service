[Unit]
Description=Set Chiron's safe initial speaker volume
Documentation=file:/usr/local/bin/chiron-audio-firstboot
ConditionUser=!root
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/chiron-audio-firstboot

[Install]
WantedBy=default.target
