# POLL=1

# Wayland output transforms for the two hinge detents. 270 is what this panel
# wants -- 90 was tried and puts landscape upside down.
# TRANSFORM_FLAT=normal
# TRANSFORM_TILTED=270

# Schmitt trigger on the sensor's X component, in g.
# FLOOR=0.15
# X_ON=0.30
# X_OFF=0.20
