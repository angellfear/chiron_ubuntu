From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chiron Builder <builder@chiron.local>
Date: Fri, 28 Aug 2026 19:46:13 +0000
Subject: [PATCH 09/44] drm/meson: build an sg_table for ION-backed GEM objects

Validated on this board.
---
 drivers/drm/meson_gem.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/drm/meson_gem.c b/drivers/drm/meson_gem.c
index 22b70f590..09ba6996d 100644
--- a/drivers/drm/meson_gem.c
+++ b/drivers/drm/meson_gem.c
@@ -541,6 +541,17 @@ static struct sg_table *meson_gem_prime_get_sg_table(struct drm_gem_object *obj)
 			kfree(dst_table);
 			return ERR_PTR(ret);
 		}
+		/* Complete the ION-backed scanout SG table before dma_map_sgtable. */
+		dst_sg = dst_table->sgl;
+		src_sg = src_table->sgl;
+		for (i = 0; i < src_table->nents; i++) {
+			sg_set_page(dst_sg, sg_page(src_sg), src_sg->length, 0);
+			sg_dma_address(dst_sg) = sg_dma_address(src_sg);
+			sg_dma_len(dst_sg) = sg_dma_len(src_sg);
+			dst_sg = sg_next(dst_sg);
+			src_sg = sg_next(src_sg);
+		}
+		return dst_table;
 	}
 	DRM_ERROR("Not support import buffer from other driver.\n");
 	return NULL;
