From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chiron Builder <builder@chiron.local>
Date: Fri, 28 Aug 2026 19:46:13 +0000
Subject: [PATCH 12/44] tee: optee: use the reserved shared memory pool

Validated on this board.
---
 drivers/aml_tee/optee/smc_abi.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/drivers/aml_tee/optee/smc_abi.c b/drivers/aml_tee/optee/smc_abi.c
index 5e9bcc3eb..b64d19a1f 100644
--- a/drivers/aml_tee/optee/smc_abi.c
+++ b/drivers/aml_tee/optee/smc_abi.c
@@ -1427,6 +1427,22 @@ static int optee_probe(struct platform_device *pdev)
 	if (!optee_get_dynamic_shm_stats(invoke_fn))
 		sec_caps &= ~(OPTEE_SMC_SEC_CAP_DYNAMIC_SHM);
 
+	/*
+	 * Chiron's secure OS is the Android 5.4-era Amlogic build.  That
+	 * kernel only supported the reserved shared-memory pool and therefore
+	 * always described client memrefs as TMEM.  With the newer dynamic pool
+	 * this driver changes the same userspace request into RMEM; the legacy
+	 * Video Firmware TA then rejects the first chunk as an invalid size.
+	 * Keep the compatibility policy in DT so other T7 boards retain the
+	 * normal dynamic-SHM preference.
+	 */
+	if (of_property_read_bool(pdev->dev.of_node,
+				  "amlogic,prefer-reserved-shm") &&
+	    (sec_caps & OPTEE_SMC_SEC_CAP_HAVE_RESERVED_SHM)) {
+		dev_info(&pdev->dev, "using legacy reserved shared memory\n");
+		sec_caps &= ~OPTEE_SMC_SEC_CAP_DYNAMIC_SHM;
+	}
+
 	/*
 	 * Try to use dynamic shared memory if possible
 	 */
