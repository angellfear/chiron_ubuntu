From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chiron Builder <builder@chiron.local>
Date: Fri, 28 Aug 2026 19:46:14 +0000
Subject: [PATCH 18/44] drm/meson: recover a dropped mode name from the
 connector mode list

Validated on this board.
---
 drivers/drm/meson_crtc.c | 48 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/drivers/drm/meson_crtc.c b/drivers/drm/meson_crtc.c
index 13a01e89b..b84c06265 100644
--- a/drivers/drm/meson_crtc.c
+++ b/drivers/drm/meson_crtc.c
@@ -577,6 +577,41 @@ static bool am_meson_crtc_mode_fixup(struct drm_crtc *crtc,
 	return true;
 }
 
+/* Userspace may hand us a mode whose timings are valid but whose name was
+ * dropped on the way in (Xorg's modesetting driver does exactly that).  The
+ * vout layer keys off the name only, so look the name back up in the
+ * connector mode list instead of failing the whole modeset.
+ */
+static const char *am_meson_crtc_mode_name(struct drm_crtc *crtc,
+					   const struct drm_display_mode *mode)
+{
+	struct drm_connector *connector;
+	struct drm_connector_list_iter conn_iter;
+	struct drm_display_mode *probed;
+	const char *name = NULL;
+
+	drm_connector_list_iter_begin(crtc->dev, &conn_iter);
+	drm_for_each_connector_iter(connector, &conn_iter) {
+		list_for_each_entry(probed, &connector->modes, head) {
+			if (!probed->name[0])
+				continue;
+			if (probed->hdisplay != mode->hdisplay ||
+			    probed->vdisplay != mode->vdisplay ||
+			    probed->htotal != mode->htotal ||
+			    probed->vtotal != mode->vtotal ||
+			    probed->clock != mode->clock)
+				continue;
+			name = probed->name;
+			break;
+		}
+		if (name)
+			break;
+	}
+	drm_connector_list_iter_end(&conn_iter);
+
+	return name;
+}
+
 static void am_meson_crtc_atomic_enable(struct drm_crtc *crtc,
 					struct drm_atomic_state *old_atomic_state)
 {
@@ -655,6 +690,19 @@ static void am_meson_crtc_atomic_enable(struct drm_crtc *crtc,
 
 	/*update mode*/
 	name = adjusted_mode->name;
+	if (!name[0]) {
+		const char *recovered =
+			am_meson_crtc_mode_name(crtc, adjusted_mode);
+
+		if (recovered) {
+			strlcpy(adjusted_mode->name, recovered,
+				DRM_DISPLAY_MODE_LEN);
+			name = adjusted_mode->name;
+			DRM_INFO("%s: unnamed %dx%d mode resolved as \"%s\"\n",
+				 __func__, adjusted_mode->hdisplay,
+				 adjusted_mode->vdisplay, name);
+		}
+	}
 	if (crtc->state->vrr_enabled) {
 		DRM_INFO("%s-[%d], adjust raw %s to brr %s\n",
 			__func__, amcrtc->crtc_index,
