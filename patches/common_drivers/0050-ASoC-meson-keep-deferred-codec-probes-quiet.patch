From 71f11ad1e8adb626b2390df6346659f47ead9a2a Mon Sep 17 00:00:00 2001
From: Chiron Builder <builder@chiron.local>
Date: Tue, 1 Sep 2026 22:59:34 +0000
Subject: [PATCH] ASoC: meson: keep deferred codec probes quiet

Change-Id: I986f624df625904dcee6017290b04843058cf15f
---
 sound/soc/amlogic/auge/card.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/sound/soc/amlogic/auge/card.c b/sound/soc/amlogic/auge/card.c
index 58a8e7ddd..562e014dc 100644
--- a/sound/soc/amlogic/auge/card.c
+++ b/sound/soc/amlogic/auge/card.c
@@ -971,7 +971,9 @@ static int aml_card_dai_link_of(struct device_node *node,
 	ret = snd_soc_of_get_dai_link_codecs(dev, codec, dai_link);
 
 	if (ret < 0) {
-		dev_err(dev, "%s, error dai-link idx:%d, error getting codec dai, ret %d\n",
+		if (ret != -EPROBE_DEFER)
+			dev_err(dev,
+				"%s, error dai-link idx:%d, error getting codec dai, ret %d\n",
 				__func__, idx, ret);
 		goto dai_link_of_err;
 	}
@@ -1609,7 +1611,8 @@ static int aml_card_probe(struct platform_device *pdev)
 
 	return 0;
 err:
-	pr_err("%s error ret:%d\n", __func__, ret);
+	if (ret != -EPROBE_DEFER)
+		pr_err("%s error ret:%d\n", __func__, ret);
 	aml_card_clean_reference(&priv->snd_card);
 
 	return ret;
-- 
