diff --git a/arch/arm64/boot/dts/amlogic/chiron-drm.dtsi b/arch/arm64/boot/dts/amlogic/chiron-drm.dtsi
new file mode 100644
index 000000000..96038f89e
--- /dev/null
+++ b/arch/arm64/boot/dts/amlogic/chiron-drm.dtsi
@@ -0,0 +1,107 @@
+/*
+ * DRM/KMS topology and the Panfrost binding for Chiron.
+ *
+ * The Amlogic KMS driver binds to the drm-subsystem node in mesont7c_drm.dtsi,
+ * which describes the full T7 output set. Chiron has exactly one output, the
+ * MIPI panel, so the HDMI, CVBS and dummy connector endpoints are left
+ * unconnected and the panel endpoint is wired to the lcd node. The topology
+ * is part of this board description rather than an overlay applied on top of
+ * the production device tree.
+ */
+
+&drm_vpu {
+	status = "okay";
+};
+
+&drm_to_hdmitx {
+	remote-endpoint = <0>;
+};
+
+&drm_to_cvbs {
+	remote-endpoint = <0>;
+};
+
+&drm_to_dummyl {
+	remote-endpoint = <0>;
+};
+
+&drm_to_lcd0 {
+	remote-endpoint = <&lcd0_to_drm>;
+};
+
+&drm_subsystem {
+	/* The panel, portrait: width, height, virtual width, virtual height,
+	 * bpp. The dtsi default describes a 1080p TV. */
+	fbdev_sizes = <1200 1920 1200 3840 32>;
+	/* Encoder masks, 0:hdmi 1:lcd 2:cvbs. Only the panel exists. */
+	crtc_masks = <1 1 1>;
+};
+
+&lcd {
+	ports {
+		port {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			lcd0_to_drm: endpoint@0 {
+				reg = <0>;
+				remote-endpoint = <&drm_to_lcd0>;
+			};
+		};
+	};
+};
+
+/*
+ * The vendor framebuffer driver and Amlogic DRM both drive the OSD hardware,
+ * and only one of them can own it. The session needs the DRM one; fbdev comes
+ * back through AMLOGIC_DRM_EMULATE_FBDEV.
+ */
+&fb {
+	status = "disabled";
+
+	/*
+	 * Disabled, but not silent: the OSD and logo code still reads these
+	 * while it takes the display over from the bootloader. Without them
+	 * the handover does not happen and the frame the ELF bootloader left
+	 * in memory stays on the panel. The geometry is this panel, not the
+	 * 1080p TV the SoC dtsi assumes, and logo_addr is where the
+	 * bootloader put that frame. All five values are the board's own,
+	 * accepted on hardware.
+	 */
+	display_size_default = <1200 1920 1200 3840 32>;
+	mem_size = <0x800000 0x1980000 0x100000 0x100000 0x100000>;
+	logo_addr = "0x20000000";
+	mem_alloc = <1>;
+	pxp_mode = <0>;
+};
+
+/*
+ * Video enhancement and video lock. The SoC dtsi leaves the tuning out, so
+ * the module comes up with none of it. These are the board's accepted
+ * values: colour management, gamma and white balance off, video lock on in
+ * mode 8 with the same limits.
+ */
+&amlvecm {
+	status = "okay";
+	gamma_en = <0>;
+	wb_en = <0>;
+	cm_en = <0>;
+	wb_sel = <0>;
+	vlock_en = <1>;
+	vlock_mode = <8>;
+	vlock_pll_m_limit = <1>;
+	vlock_line_limit = <2>;
+};
+
+/*
+ * Panfrost rather than the vendor kbase. The SoC dtsi describes the Mali as a
+ * Midgard part for the vendor driver; the upstream driver binds on the bifrost
+ * compatible and looks up its interrupts by lowercase name. The resets are the
+ * two Mali lines the vendor driver would otherwise assert itself.
+ */
+&gpu {
+	compatible = "amlogic,meson-g12a-mali", "arm,mali-bifrost";
+	dma-coherent;
+	interrupt-names = "gpu", "mmu", "job";
+	resets = <&reset RESET_MALI_CAPB3>, <&reset RESET_MALI>;
+};
diff --git a/arch/arm64/boot/dts/amlogic/chiron-panel.dtsi b/arch/arm64/boot/dts/amlogic/chiron-panel.dtsi
