 arch/arm64/boot/dts/amlogic/chiron-drm.dtsi   | 107 ++++
 arch/arm64/boot/dts/amlogic/chiron-panel.dtsi | 457 ++++++++++++++++++
 arch/arm64/boot/dts/amlogic/chiron.dts        | 2181 ++++++++++++++++
 4 files changed, 2746 insertions(+)
 create mode 100644 arch/arm64/boot/dts/amlogic/chiron-drm.dtsi
