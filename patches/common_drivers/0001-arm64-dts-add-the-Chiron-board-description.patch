diff --git a/arch/arm64/boot/dts/amlogic/chiron.dts b/arch/arm64/boot/dts/amlogic/chiron.dts
new file mode 100644
index 000000000..5fe7b646b
--- /dev/null
+++ b/arch/arm64/boot/dts/amlogic/chiron.dts
@@ -0,0 +1,2181 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Yandex Chiron (Duo) - A311D2 / T7C.
+ *
+ * Own board file: it reuses the locked Amlogic T7C SoC description
+ * (mesont7c.dtsi) and describes only what is fitted on this board.  No other
+ * board's DTS is included.  Every board value below is taken from the
+ * validated on this board, which is the reference for
+ * this hardware.
+ *
+ * It covers the whole fitted board: boot, serial console, eMMC, the W2
+ * SDIO Wi-Fi/BT module, display, touch, audio, camera, NPU and their
+ * memory pools.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/reset/amlogic,meson-t7-reset.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include "mesont7c.dtsi"
+#include "chiron-panel.dtsi"
+#include "mesont7c_drm.dtsi"
+#include "chiron-drm.dtsi"
+
+/ {
+	model = "Yandex Chiron";
+	compatible = "yandex,chiron", "amlogic, t7c";
+	amlogic-dt-id = "t7c_a311d2_chiron-pvt";
+	interrupt-parent = <&gic>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		serial0 = &uart_A;
+		serial1 = &uart_C;
+		serial3 = &uart_D;
+	};
+
+	/* 3 GiB fitted; this is the accepted reservation window. */
+	memory {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0xbf800000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		ramoops@8400000 {
+			compatible = "ramoops";
+			reg = <0x0 0x08400000 0x0 0x00100000>;
+			record-size = <0x20000>;
+			console-size = <0x40000>;
+			ftrace-size = <0x80000>;
+			pmsg-size = <0x20000>;
+		};
+
+		/*
+		 * Plain reservation, deliberately without a recognised
+		 * compatible and without no-map, exactly as this board
+		 * requires it:
+		 *
+		 *  - "shared-dma-pool" hands these 52 MiB of secure-monitor
+		 *    memory to CMA.  Once aml_cma latches cma_enabled, page
+		 *    cache is allocated out of it, buffered reads come back
+		 *    holding foreign data, and an access the secure world
+		 *    refuses raises an asynchronous SError panic.
+		 *  - no compatible makes __reserved_mem_init_node() return
+		 *    -ENOENT, which fdt_init_reserved_mem() tolerates without
+		 *    freeing the range, so it simply stays reserved.
+		 *  - no-map must not be used: secmon.c dereferences
+		 *    __phys_to_virt(rmem->base), which needs the linear map.
+		 */
+		secmon_reserved: linux,secmon {
+			reg = <0x0 0x05000000 0x0 0x03400000>;
+		};
+
+		/*
+		 * The accepted layout reserves one 16 MiB DSP firmware window
+		 * at 0x40000000 for a single hifi4dsp node.  This kernel splits
+		 * the same window between the two hifidsp nodes it describes.
+		 */
+		dsp_fw_reserved0: linux,dsp_fw0 {
+			compatible = "amlogic, dsp";
+			size = <0x0 0x800000>;
+			reg = <0x0 0x40000000 0x0 0x800000>;
+		};
+
+		dsp_fw_reserved1: linux,dsp_fw1 {
+			compatible = "amlogic, dsp";
+			size = <0x0 0x800000>;
+			reg = <0x0 0x40800000 0x0 0x800000>;
+		};
+
+		/* DDR bandwidth monitor scratch; size only, address floating. */
+		/*
+		 * The pools below are the hardware-accepted Chiron ones,
+		 * unchanged.  codec_mm_cma is the one the
+		 * display depends on: aml_drm allocates its scanout buffer from
+		 * the "heap-codecmm" dma-heap, which is backed by this pool, and
+		 * that heap must be physically contiguous because the display
+		 * controller is given a single base address.  Without the pool
+		 * the allocation fails and the compositor exits right after the
+		 * modeset.
+		 */
+		codec_mm_cma: linux,codec_mm_cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x0 0x1b000000>;
+			alignment = <0x0 0x400000>;
+			linux,contiguous-region;
+			clear-map;
+		};
+
+		ppmgr_reserved: linux,ppmgr {
+			compatible = "shared-dma-pool";
+			size = <0x0 0x0>;
+		};
+
+		camera_cma_reserved: linux,camera_cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			status = "okay";
+			size = <0x0 0x11000000>;
+			alignment = <0x0 0x400000>;
+			alloc-ranges = <0x0 0x0 0x0 0xe0000000>;
+		};
+
+		isp_cma_reserved: linux,isp_cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			status = "okay";
+			size = <0x0 0x14400000>;
+			alignment = <0x0 0x400000>;
+		};
+
+		adapt_cma_reserved: linux,adapt_cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			status = "okay";
+			size = <0x0 0x1800000>;
+			alignment = <0x0 0x400000>;
+		};
+
+		dmc_reserved: linux,dmc_monitor {
+			compatible = "amlogic,dmc_monitor-reserved";
+			reg = <0x0 0x0 0x0 0x80000>;
+		};
+
+		logo_reserved: linux,meson-fb {
+			compatible = "amlogic, meson-fb";
+			reg = <0x0 0x20000000 0x0 0x2000000>;
+			size = <0x0 0x2000000>;
+			alignment = <0x0 0x400000>;
+			alloc-ranges = <0x0 0x20000000 0x0 0x2000000>;
+		};
+
+		ion_cma_reserved: linux,ion-dev {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x0 0x9800000>;
+			alignment = <0x0 0x400000>;
+		};
+
+		ion_secure_reserved: linux,ion-secure {
+			compatible = "amlogic, ion-secure-mem";
+			no-map;
+			size = <0x0 0x0>;
+			alignment = <0x0 0x400000>;
+		};
+
+		ion_fb_reserved: linux,ion-fb {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x0 0x1c00000>;
+			alignment = <0x0 0x400000>;
+		};
+
+		codec_mm_reserved: linux,codec_mm_reserved {
+			compatible = "amlogic, codec-mm-reserved";
+			size = <0x0 0x0>;
+			alignment = <0x0 0x100000>;
+		};
+
+		adla_reserved: linux,adla_reserved {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x0 0x18000000>;
+			alignment = <0x0 0x400000>;
+		};
+	};
+
+	/*
+	 * W2 combo module supply: fixed 3.3 V rail enabled by GPIOT_10 with a
+	 * 10 ms settle, always on.  Without it the module never powers up and
+	 * no SDIO card appears.
+	 */
+
+	/* Consumers of the pools above, as this board declares them. */
+	codec_mm {
+		compatible = "amlogic, codec, mm";
+		memory-region = <&codec_mm_cma &codec_mm_reserved>;
+		dev_name = "codec_mm";
+		status = "okay";
+	};
+
+	ppmgr {
+		compatible = "amlogic, ppmgr";
+		memory-region = <&ppmgr_reserved>;
+		dev_name = "ppmgr";
+		status = "okay";
+	};
+
+	wifi_bt_regulator {
+		compatible = "regulator-fixed";
+		status = "okay";
+		regulator-name = "wifi_bt_regulator";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio GPIOT_10 GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <10000>;
+		enable-active-high;
+		regulator-always-on;
+	};
+};
+
+/* Serial console on UART_A, the port wired to the service connector. */
+&uart_A {
+	status = "okay";
+};
+
+/*
+ * UART_C is the W2 Bluetooth transport. The controller runs H4 at 4 Mbit/s
+ * once its firmware is loaded, which needs the hardware flow control the four
+ * uart_c pins carry; the dtsi already points this node at them. The serial1
+ * alias is what makes it /dev/ttyS1, which is the name the loader and
+ * btattach both use.
+ */
+&uart_C {
+	status = "okay";
+	uart-has-rtscts;
+};
+
+/*
+ * UART_D is the Telink Zigbee coordinator, at 115200 8N1 with no flow
+ * control. The serial3 alias is what makes it /dev/ttyS3, the name Android
+ * symlinks as /dev/zigbee_uart and the one the host software uses. Its power,
+ * reset and boot lines are GPIOH_2, GPIOH_5 and GPIOH_6; they are driven from
+ * userspace with gpiod rather than described here, because the vendor's
+ * zigbee-control driver -- which is all the vendor node is for -- is a
+ * proprietary module this kernel does not have.
+ */
+&uart_D {
+	status = "okay";
+};
+
+/* eMMC: the only fitted storage; Android, boot files and our root live here. */
+&sd_emmc_c {
+	status = "okay";
+	pinctrl-0 = <&emmc_pins>, <&emmc_ds_pins>;
+	pinctrl-1 = <&emmc_clk_gate_pins>;
+	pinctrl-names = "default", "clk-gate";
+
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-ddr-1_8v;
+	mmc-hs200-1_8v;
+	mmc-hs400-1_8v;
+	max-frequency = <200000000>;
+	non-removable;
+	disable-wp;
+};
+
+/*
+ * No SD card slot on this board.  Leaving the controller enabled would also
+ * claim the C-bank pins that carry the W2 host wake and power enable.
+ */
+&sd_emmc_b {
+	status = "disabled";
+};
+
+/* SDIO: the W2 Wi-Fi module, non-removable, four bit. */
+&sd_emmc_a {
+	status = "okay";
+	pinctrl-0 = <&sdio_pins>;
+	pinctrl-1 = <&sdio_clk_gate_pins>;
+	pinctrl-names = "default", "clk-gate";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	bus-width = <4>;
+	cap-sd-highspeed;
+	sd-uhs-sdr50;
+	sd-uhs-sdr104;
+	max-frequency = <200000000>;
+	non-removable;
+	disable-wp;
+};
+
+/*
+ * Audio, as accepted on this board.
+ *
+ * mesont7.dtsi carries only the audio bus, its clock controller, the DDR
+ * manager and an empty pinctrl node -- every TDM, PDM and SPDIF endpoint and
+ * the sound card itself are board properties and are defined here.
+ *
+ * Clock indices are kept as the numbers the accepted DTB holds rather than
+ * rewritten into CLKID_* macros. They are two headers' worth of base-plus-
+ * offset arithmetic (MCLK_BASE in amlogic,t7-audio-clk.h, CLKID_PLL_BASE in
+ * amlogic,t7-clkc.h), and a translation error there is silent: the wrong clock
+ * still probes and the path is simply dead. The names are one lookup away for
+ * anyone reading; the values are what the board is accepted with.
+ *
+ * The topology, from the sound card below:
+ *   link 0  TDM-A, dsp_b   -> dummy codec        alsaPORT-pcm
+ *   link 1  TDM-B, i2s     -> two FS2105 amps    alsaPORT-i2s     (2.1 speakers)
+ *   link 2  TDM-C, i2s in  -> ES7210 4ch ADC     alsaPORT-hwfeedback
+ *   link 3  PDM            -> dummy codec        alsaPORT-pdm     (8ch mic array)
+ *   link 4  SPDIF-A        -> dummy codec        alsaPORT-spdif
+ *   link 5  SPDIF-B        -> dummy codec        alsaPORT-spdifb
+ *
+ * The speakers are 2.1 -- a woofer plus left/right mid-high -- while the host
+ * stream stays stereo on TDM-B. PCM 0 is a dummy TDM-A endpoint only.
+ */
+
+/* Audio pin groups the SoC dtsi does not carry. */
+&periphs_pinctrl {
+	tdm_a_pin: tdm_a_pin {
+		mux {
+			groups = "tdm_sclk0", "tdm_fs0", "tdm_d0", "tdm_d1";
+			function = "tdm";
+		};
+	};
+
+	tdmout_b: tdmout_b {
+		mux {
+			groups = "tdm_sclk2", "tdm_fs2", "tdm_d10", "tdm_d11";
+			function = "tdm";
+		};
+	};
+
+	tdmout_c: tdmout_c {
+		mux {
+			groups = "mclk1", "tdm_sclk1", "tdm_fs1", "tdm_d2";
+			function = "tdm";
+		};
+	};
+
+	pdmin_pin: pdmin_pin {
+		mux {
+			groups = "pdm_dclk", "pdm_din0", "pdm_din1_m5",
+				 "pdm_din2", "pdm_din3";
+			function = "pdm";
+		};
+	};
+
+	mclk_1_pin: mclk_1_pin {
+		mux {
+			groups = "mclk1";
+			function = "mclk";
+		};
+	};
+
+	mclk_2_pin: mclk_2_pin {
+		mux {
+			groups = "mclk2";
+			function = "mclk";
+		};
+	};
+};
+
+&audiobus {
+	pinctrl_audio_board: pinctrl {
+		tdm_d4_pin: tdm_d4_pin {
+			mux {
+				groups = "tdm_d4";
+				function = "tdmouta_lane0";
+			};
+		};
+
+		tdm_d0_pin: tdm_d0_pin {
+			mux {
+				groups = "tdm_d0";
+				function = "tdmouta_lane0";
+			};
+		};
+
+		tdm_d1_pin: tdm_d1_pin {
+			mux {
+				groups = "tdm_d1";
+				function = "tdmina_lane0";
+			};
+		};
+
+		tdm_d2_pin: tdm_d2_pin {
+			mux {
+				groups = "tdm_d2";
+				function = "tdminc_lane0";
+			};
+		};
+
+		tdm_d5_pin: tdm_d5_pin {
+			mux {
+				groups = "tdm_d5";
+				function = "tdmouta_lane1";
+			};
+		};
+
+		tdma_clk_pin: tdma_clk_pin {
+			mux {
+				groups = "tdm_sclk0", "tdm_lrclk0";
+				function = "tdm_clk_outa";
+			};
+		};
+
+		tdmc_clk_pin: tdmc_clk_pin {
+			mux {
+				groups = "tdm_sclk1", "tdm_lrclk1";
+				function = "tdm_clk_outc";
+			};
+		};
+
+		tdm_d10_pin: tdm_d10_pin {
+			mux {
+				groups = "tdm_d10";
+				function = "tdmoutb_lane0";
+			};
+		};
+
+		tdm_d11_pin: tdm_d11_pin {
+			mux {
+				groups = "tdm_d11";
+				function = "tdmoutb_lane1";
+			};
+		};
+
+		tdmb_clk_pin: tdmb_clk_pin {
+			mux {
+				groups = "tdm_sclk2", "tdm_lrclk2";
+				function = "tdm_clk_outb";
+			};
+		};
+	};
+
+	tdma: tdm@0 {
+		compatible = "amlogic, t7-snd-tdma";
+		#sound-dai-cells = <0>;
+		dai-tdm-lane-slot-mask-in = <1 0 0 0>;
+		dai-tdm-lane-slot-mask-out = <1 0 0 0>;
+		dai-tdm-clk-sel = <0>;
+		clocks = <&clkaudio 0x2a>, <&clkaudio 0x41>, <&clkc 0x2d>,
+			 <&clkc 0x2f>, <&clkaudio 0x31>;
+		clock-names = "mclk", "mclk_pad", "clk_srcpll",
+			      "samesource_srcpll", "samesource_clk";
+		pinctrl-names = "tdm_pins";
+		pinctrl-0 = <&tdm_a_pin &tdm_d0_pin &tdm_d1_pin &tdma_clk_pin>;
+		status = "okay";
+	};
+
+	tdmb: tdm@1 {
+		compatible = "amlogic, t7-snd-tdmb";
+		#sound-dai-cells = <0>;
+		dai-tdm-lane-slot-mask-in = <0 0>;
+		dai-tdm-lane-slot-mask-out = <1 1>;
+		dai-tdm-clk-sel = <1>;
+		start_clk_enable = <1>;
+		/* The 2.1 amps expect the woofer on the first slot. */
+		swap_channels = <1 0 2 3 4 5 6 7>;
+		clocks = <&clkaudio 0x2b>, <&clkaudio 0x42>, <&clkc 0x2f>;
+		clock-names = "mclk", "mclk_pad", "clk_srcpll";
+		pinctrl-names = "tdm_pins";
+		pinctrl-0 = <&tdmout_b &tdm_d10_pin &tdm_d11_pin
+			     &mclk_2_pin &tdmb_clk_pin>;
+		status = "okay";
+	};
+
+	tdmc: tdm@2 {
+		compatible = "amlogic, t7-snd-tdmc";
+		#sound-dai-cells = <0>;
+		dai-tdm-lane-slot-mask-in = <1 0 0 0>;
+		dai-tdm-clk-sel = <2>;
+		clocks = <&clkaudio 0x2c>, <&clkaudio 0x41>, <&clkc 0x31>;
+		clock-names = "mclk", "mclk_pad", "clk_srcpll";
+		pinctrl-names = "tdm_pins";
+		pinctrl-0 = <&mclk_1_pin &tdmout_c &tdm_d2_pin &tdmc_clk_pin>;
+		start_clk_enable = <1>;
+		status = "okay";
+	};
+
+	/*
+	 * The eight-channel speech microphone array. All four lanes are
+	 * enabled; the vendor probe hardcodes lane_mask_in to 0x8 over
+	 * whatever the device tree says, which is what the pdm patch in the
+	 * common_drivers queue removes.
+	 */
+	pdm: pdm {
+		compatible = "amlogic, tm2-revb-snd-pdm";
+		#sound-dai-cells = <0>;
+		clocks = <&clkaudio 0x01>, <&clkc 0x07>, <&clkc 0x33>,
+			 <&clkaudio 0x35>, <&clkaudio 0x36>;
+		clock-names = "gate", "sysclk_srcpll", "dclk_srcpll",
+			      "pdm_dclk", "pdm_sysclk";
+		pinctrl-names = "pdm_pins";
+		pinctrl-0 = <&pdmin_pin>;
+		filter_mode = <1>;
+		train_sample_count = <11>;
+		status = "okay";
+	};
+
+	spdifa: spdif@0 {
+		compatible = "amlogic, tm2-revb-snd-spdif-a";
+		#sound-dai-cells = <0>;
+		clocks = <&clkc 0x2d>, <&clkc 0x09>, <&clkaudio 0x10>,
+			 <&clkaudio 0x11>, <&clkaudio 0x30>, <&clkaudio 0x31>;
+		clock-names = "sysclk", "fixed_clk", "gate_spdifin",
+			      "gate_spdifout", "clk_spdifin", "clk_spdifout";
+		interrupts = <GIC_SPI 35 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "irq_spdifin";
+		pinctrl-names = "spdif_pins", "spdif_pins_mute";
+		pinctrl-0 = <&spdifout_d>;
+		pinctrl-1 = <&spdifout_d_mute>;
+		samesource_sel = <4>;
+		clk_tuning_enable = <1>;
+		status = "okay";
+	};
+
+	spdifb: spdif@1 {
+		compatible = "amlogic, tm2-revb-snd-spdif-b";
+		#sound-dai-cells = <0>;
+		clocks = <&clkc 0x31>, <&clkaudio 0x15>, <&clkaudio 0x37>;
+		clock-names = "sysclk", "gate_spdifout", "clk_spdifout";
+		status = "okay";
+	};
+
+	extn: extn {
+		compatible = "amlogic, t7-snd-extn";
+		#sound-dai-cells = <0>;
+		interrupts = <GIC_SPI 42 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "irq_frhdmirx";
+		status = "okay";
+	};
+
+	effect: effect {
+		compatible = "amlogic, snd-effect-v4";
+		#sound-dai-cells = <0>;
+		clocks = <&clkaudio 0x16>, <&clkc 0x0b>, <&clkaudio 0x3a>;
+		clock-names = "gate", "srcpll", "eqdrc";
+		eqdrc_module = <0>;
+		lane_mask = <1>;
+		channel_mask = <0xff>;
+		status = "okay";
+	};
+
+	resample_a: resample@0 {
+		compatible = "amlogic, t5-resample-a";
+		clocks = <&clkc 0x2f>, <&clkaudio 0x2b>, <&clkaudio 0x32>;
+		clock-names = "resample_pll", "resample_src", "resample_clk";
+		resample_module = <8>;
+		status = "okay";
+	};
+
+	resample_b: resample@1 {
+		compatible = "amlogic, t5-resample-b";
+		clocks = <&clkc 0x33>, <&clkaudio 0x2f>, <&clkaudio 0x38>;
+		clock-names = "resample_pll", "resample_src", "resample_clk";
+		capture_sample_rate = <16000>;
+		status = "disabled";
+	};
+
+	vad: vad {
+		compatible = "amlogic, snd-vad";
+		#sound-dai-cells = <0>;
+		clocks = <&clkaudio 0x1b>, <&clkc 0x0b>, <&clkaudio 0x3b>;
+		clock-names = "gate", "pll", "clk";
+		interrupts = <GIC_SPI 39 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 44 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "irq_wakeup", "irq_frame_sync";
+		src = <4>;
+		level = <1>;
+		status = "okay";
+	};
+};
+
+/*
+ * Loopback capture: the microphone array with a reference of what is being
+ * played, which is what an echo canceller needs. loopbacka takes the eight PDM
+ * channels plus three TDM-B slots; loopbackb is the four-channel variant and is
+ * off, as in the accepted tree.
+ */
+&audiobus {
+	loopbacka: loopback@0 {
+		compatible = "amlogic, t5-loopbacka";
+		#sound-dai-cells = <0>;
+		clocks = <&clkaudio 0x01>, <&clkc 0x07>, <&clkc 0x33>,
+			 <&clkaudio 0x35>, <&clkaudio 0x36>, <&clkc 0x2d>,
+			 <&clkaudio 0x2a>;
+		clock-names = "pdm_gate", "pdm_sysclk_srcpll",
+			      "pdm_dclk_srcpll", "pdm_dclk", "pdm_sysclk",
+			      "tdminlb_mpll", "tdminlb_mclk";
+		datain_src = <4>;
+		datain_chnum = <8>;
+		datain_chmask = <0xff>;
+		datain-lane-mask-in = <1 1 1 1>;
+		mclk-fs = <256>;
+		datalb_src = <6>;
+		datalb_chnum = <3>;
+		datalb_chmask = <0x7>;
+		datalb-lane-mask-in = <1 0 0 0>;
+		datalb-channels-mask = <1 1 1 0>;
+		datalb-slot-width = <16>;
+		status = "okay";
+	};
+
+	loopbackb: loopback@1 {
+		compatible = "amlogic, t5-loopbackb";
+		#sound-dai-cells = <0>;
+		clocks = <&clkaudio 0x01>, <&clkc 0x07>, <&clkc 0x33>,
+			 <&clkaudio 0x35>, <&clkaudio 0x36>, <&clkc 0x2d>,
+			 <&clkaudio 0x2a>;
+		clock-names = "pdm_gate", "pdm_sysclk_srcpll",
+			      "pdm_dclk_srcpll", "pdm_dclk", "pdm_sysclk",
+			      "tdminlb_mpll", "tdminlb_mclk";
+		mclk-fs = <256>;
+		datain_src = <4>;
+		datain_chnum = <4>;
+		datain_chmask = <0xf>;
+		datain-lane-mask-in = <1 0 1 0>;
+		datalb_src = <1>;
+		datalb_chnum = <2>;
+		datalb_chmask = <0x3>;
+		datalb-lane-mask-in = <1 0 0 0>;
+		status = "disabled";
+	};
+};
+
+/*
+ * ES7210: the four-channel ADC that feeds the amplifier hardware feedback path
+ * back to the SoC. 100 kHz bus, shared with the power-delivery controller and
+ * the board EEPROM.
+ */
+&i2c0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c0_pins1>;
+	clock-frequency = <100000>;
+
+	es7210: es7210@40 {
+		compatible = "everest,es7210_4ch";
+		#sound-dai-cells = <0>;
+		reg = <0x40>;
+		status = "okay";
+	};
+};
+
+/*
+ * SC7A20E accelerometer. The panel rotation is decided from it, so the board
+ * needs the node even though nothing else on this bus is described: the RTC is
+ * unpopulated, the EEPROMs are read from Android and the MC34X9 at 0x6c is the
+ * other board variant.
+ *
+ * mount-matrix is the identity, which is the accepted setting. The
+ * vendor node carries "orient = <6>" instead -- an index into a vendor table
+ * that no mainline consumer reads -- so the placement is not described in the
+ * DT at all and the whole orientation policy lives in chiron-autorotate.
+ * Writing a real matrix here would move half of that policy into the kernel
+ * and leave the other half in userspace disagreeing with it.
+ */
+&i2c1 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c1_pins1>;
+	clock-frequency = <100000>;
+
+	sc7a20e: sc7a20e@19 {
+		compatible = "silan,sc7a20e_acc";
+		reg = <0x19>;
+		status = "okay";
+		mount-matrix = "1", "0", "0",
+			       "0", "1", "0",
+			       "0", "0", "1";
+	};
+};
+
+/*
+ * STK3B6X ambient light sensor. The interrupt line is described because it is
+ * a fact about the board; the driver polls at 2 Hz while something holds the
+ * device open and does not use it.
+ */
+&i2c4 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c4_pins1>;
+	clock-frequency = <400000>;
+
+	stk3b6x: ams_stk37660@48 {
+		compatible = "stk,stk3b6x";
+		reg = <0x48>;
+		status = "okay";
+		stk,irq-gpio = <&gpio GPIOY_13 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+/*
+ * The two FS2105 speaker amplifiers. dev-index, not the I2C address, decides
+ * which is the woofer: index 0 at 0x6a, index 1 at 0x68. Each has its own
+ * shutdown line, active low.
+ */
+&i2c3 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c3_pins1>;
+	clock-frequency = <400000>;
+
+	fs2105_1: audio-codec@68 {
+		compatible = "foursemi, fs2105";
+		#sound-dai-cells = <0>;
+		reg = <0x68>;
+		fsm,sdz-gpio = <&gpio GPIOT_8 GPIO_ACTIVE_LOW>;
+		fsm,dev-index = <1>;
+	};
+
+	fs2105_0: audio-codec@6a {
+		compatible = "foursemi, fs2105";
+		#sound-dai-cells = <0>;
+		reg = <0x6a>;
+		fsm,sdz-gpio = <&gpio GPIOT_7 GPIO_ACTIVE_LOW>;
+		fsm,dev-index = <0>;
+	};
+};
+
+/*
+ * The LED ring: 48 RGB pixels driven by four AW21036 controllers on the same
+ * bus as the amplifiers. The whole ring is described here because the driver
+ * takes the pixel identity from the DT and nothing else knows it: the physical
+ * controller order is 0x37, 0x36, 0x34, 0x35, and the channels on 0x34 are
+ * scrambled relative to the other three. Both facts live in the label/reg
+ * pairs below, which is what lets userspace address a pixel by name --
+ * chiron:<colour>:ring<0..47> -- and never see an I2C address.
+ *
+ * The defaults (GCC, COL, white balance, PWM frequency and phase) are read by
+ * the driver at probe; the led_sync child of each controller is the channel
+ * that commits a frame.
+ */
+&i2c3 {
+	aw21036@34 {
+		compatible = "awinic,aw21036";
+		reg = <0x34>;
+		status = "okay";
+		#address-cells = <0x01>;
+		#size-cells = <0x00>;
+		gcc-default = <0xff>;
+		col-default = <0xff>;
+		wb-default = <0xff 0xff 0xff>;
+		pwm-freq-default = <0x00>;
+		pwm-phase-delay-default = <0x00>;
+		pwm-phase-invert-default = <0x00>;
+
+		led_sync {
+			led-sync;
+			label = "chiron:ring0-11:sync";
+			linux,default-trigger = "led_ring_fb-sync";
+		};
+
+		led0_r {
+			reg = <0x18>;
+			label = "chiron:red:ring0";
+			linux,default-trigger = "led_ring_fb";
+		};
+
+		led0_g {
+			reg = <0x19>;
+			label = "chiron:green:ring0";
+			linux,default-trigger = "led_ring_fb";
+		};
+
+		led0_b {
+			reg = <0x1a>;
+			label = "chiron:blue:ring0";
+			linux,default-trigger = "led_ring_fb";
+		};
+
+		led1_r {
+			reg = <0x15>;
+			label = "chiron:red:ring1";
+			linux,default-trigger = "led_ring_fb";
+		};
+
+		led1_g {
+			reg = <0x16>;
+			label = "chiron:green:ring1";
+			linux,default-trigger = "led_ring_fb";
+		};
+
+		led1_b {
+			reg = <0x17>;
+			label = "chiron:blue:ring1";
+			linux,default-trigger = "led_ring_fb";
+		};
+
+		led2_r {
+			reg = <0x12>;
+			label = "chiron:red:ring2";
+			linux,default-trigger = "led_ring_fb";
+		};
+
+		led2_g {
+			reg = <0x13>;
+			label = "chiron:green:ring2";
+			linux,default-trigger = "led_ring_fb";
+		};
+
+		led2_b {
+			reg = <0x14>;
+			label = "chiron:blue:ring2";
+			linux,default-trigger = "led_ring_fb";
+		};
+
+		led3_r {
+			reg = <0x0f>;
+			label = "chiron:red:ring3";
+			linux,default-trigger = "led_ring_fb";
+		};
+
