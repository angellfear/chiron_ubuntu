+		compatible = "amlogic, auge-sound-card";
+		aml-audio-card,name = "AML-AUGESOUND";
+		interrupts = <GIC_SPI 51 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "audio_exception64";
+		status = "okay";
+		spk_mute-gpios = <&gpio GPIOM_12 GPIO_ACTIVE_HIGH>;
+
+		aml-audio-card,dai-link@0 {
+			format = "dsp_b";
+			mclk-fs = <64>;
+			bitclock-master = <&tdma>;
+			frame-master = <&tdma>;
+			suffix-name = "alsaPORT-pcm";
+
+			cpu {
+				sound-dai = <&tdma>;
+				dai-tdm-slot-tx-mask = <1>;
+				dai-tdm-slot-rx-mask = <1>;
+				dai-tdm-slot-num = <2>;
+				dai-tdm-slot-width = <16>;
+				system-clock-frequency = <512000>;
+			};
+
+			codec {
+				sound-dai = <&dummy_codec>;
+			};
+		};
+
+		aml-audio-card,dai-link@1 {
+			format = "i2s";
+			mclk-fs = <256>;
+			bitclock-master = <&tdmb>;
+			frame-master = <&tdmb>;
+			suffix-name = "alsaPORT-i2s";
+
+			cpu {
+				sound-dai = <&tdmb>;
+				dai-tdm-slot-tx-mask = <1 1>;
+				dai-tdm-slot-rx-mask = <0 0>;
+				dai-tdm-slot-num = <2>;
+				dai-tdm-slot-width = <32>;
+				system-clock-frequency = <12288000>;
+			};
+
+			codec {
+				prefix-names = "woofer", "tweeters";
+				sound-dai = <&fs2105_1 &fs2105_0>;
+			};
+		};
+
+		aml-audio-card,dai-link@2 {
+			format = "i2s";
+			mclk-fs = <256>;
+			bitclock-master = <&tdmc>;
+			frame-master = <&tdmc>;
+			suffix-name = "alsaPORT-hwfeedback";
+
+			cpu {
+				sound-dai = <&tdmc>;
+				system-clock-frequency = <12288000>;
+				dai-tdm-slot-rx-mask = <1 0 1 1>;
+				dai-tdm-slot-num = <4>;
+				dai-tdm-slot-width = <16>;
+			};
+
+			codec {
+				prefix-names = "Loopback";
+				sound-dai = <&es7210>;
+			};
+		};
+
+		aml-audio-card,dai-link@3 {
+			mclk-fs = <64>;
+			suffix-name = "alsaPORT-pdm";
+
+			cpu {
+				sound-dai = <&pdm>;
+			};
+
+			codec {
+				sound-dai = <&dummy_codec>;
+			};
+		};
+
+		aml-audio-card,dai-link@4 {
+			mclk-fs = <128>;
+			continuous-clock;
+			suffix-name = "alsaPORT-spdif";
+
+			cpu {
+				sound-dai = <&spdifa>;
+				system-clock-frequency = <6144000>;
+			};
+
+			codec {
+				sound-dai = <&dummy_codec>;
+			};
+		};
+
+		aml-audio-card,dai-link@5 {
+			mclk-fs = <128>;
+			suffix-name = "alsaPORT-spdifb";
+
+			cpu {
+				sound-dai = <&spdifb>;
+				system-clock-frequency = <6144000>;
