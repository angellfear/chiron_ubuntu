+/*
+ * SAR ADC: only the volume keys hang off it, on channel 2.
+ */
+&saradc {
+	status = "okay";
+};
+
+/*
+ * Volume keys. The board has exactly two physical keys and they are resistor
+ * coded on ADC channel 2: 0xc8 and 0x1e with a tolerance of 0x32 either side,
+ * reporting KEY_VOLUMEUP (0x73) and KEY_VOLUMEDOWN (0x72). Values, tolerances
+ * and order are the accepted ones for this board, unchanged --
+ * they are a property of the resistor ladder, not a preference.
+ *
+ * The node has no reg, so it lives at the root next to the other Amlogic
+ * platform devices rather than under /soc.
+ */
+&{/} {
+	adc_keypad {
+		compatible = "amlogic, adc_keypad";
+		status = "okay";
+		key_name = "vol+", "vol-";
+		key_num = <2>;
+		io-channels = <&saradc 2>;
+		io-channel-names = "key-chan-2";
+		key_chan = <2 2>;
+		key_code = <KEY_VOLUMEUP KEY_VOLUMEDOWN>;
+		key_val = <0xc8 0x1e>;
+		key_tolerance = <0x32 0x32>;
+	};
+
+	/*
+	 * The two privacy switches, reported as EV_SW so they carry state
+	 * rather than an edge: the lens cover and the microphone mute slider
+	 * are positions, and anything reading them at start-up has to see
+	 * where they are, not wait for the next flip. The camera switch is
+	 * active low, the mute switch active high, as wired.
+	 */
+	gpio-keys {
+		compatible = "gpio-keys";
+		label = "switches";
+
+		camera-switch {
+			label = "camera-switch";
+			linux,code = <SW_CAMERA_LENS_COVER>;
+			linux,input-type = <EV_SW>;
+			gpios = <&gpio GPIOT_22 GPIO_ACTIVE_LOW>;
+		};
+
+		mute-switch {
+			label = "mute-switch";
+			linux,code = <SW_MUTE_DEVICE>;
+			linux,input-type = <EV_SW>;
+			gpios = <&gpio GPIOH_0 GPIO_ACTIVE_HIGH>;
+		};
+	};
+};
+/*
+ * Touchscreen: Himax HX83102 in-cell controller on SPICC2, as accepted on
+ * this board. The label is the trap here -- the panel and the
+ * digitiser are the same glass, but the controller is spi@54000, which
+ * mesont7.dtsi labels spicc2, not spicc3; a decompiled DTB names its pin
+ * group spicc3_pins only because of its own node ordering.
+ * Interrupt 167 and the spi2_* pin function both confirm the controller.
+ *
+ * spi-cpol and spi-cpha are kept exactly as the decompiled DTB holds them:
+ * four bytes of zero rather than empty properties. of_spi_parse_dt() tests them
+ * with of_property_read_bool(), which is true for a property that exists at
+ * all, so this is mode 3 and not mode 0. It is what the accepted board runs.
+ *
+ * The driver itself is an external module built from the pinned Google source
+ * (see patches/himax and scripts/builder/build-himax.sh); the axis orientation
+ * is a module parameter, not a device tree property, because the digitiser's
+ * origin is fixed relative to the glass and must not follow display rotation.
+ */
+&spicc2 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&spicc2_pins>;
+	cs-gpios = <&gpio GPIOY_3 GPIO_ACTIVE_HIGH>;
+
+	himax_tp@0 {
+		compatible = "himax,hxcommon";
+		device_name = "himax_tp";
+		status = "okay";
+		reg = <0>;
+		spi-cpol = <0>;
+		spi-cpha = <0>;
+		spi-max-frequency = <10000000>;
+		himax,panel-coords = <0 1200 0 1920>;
+		himax,display-coords = <0 1200 0 1920>;
+		himax,irq-gpio = <&gpio GPIOY_10 GPIO_ACTIVE_HIGH>;
+		himax,rst-gpio = <&gpio GPIOY_7 GPIO_ACTIVE_HIGH>;
+	};
+};
+/*
+ * OP-TEE shared memory. Without this the driver allocates its shared memory
+ * from the general pool instead of the reserved one this board sets aside --
+ * the pool the video firmware TA is reached through. The kernel side of this
+ * is already in the queue; this is the board half of the same change. The
+ * node has no label in the SoC dtsi, so it is extended by path.
+ */
+&{/optee} {
+	amlogic,prefer-reserved-shm;
+};
+
+/*
+ * Deinterlacer. This board has one progressive MIPI panel and no interlaced
+ * or 4K source, so the scatter allocator and the 4K path stay off exactly as
+ * they are accepted on this board: both reserve memory the display path
+ * needs and neither has anything to deinterlace.
+ */
+&{/multi-di} {
+	alloc_sct = <0>;
+	en_4k = <0>;
+};
+
+/*
+ * PWM channels. The SoC dtsi ships every controller except PWM_A and
+ * PWM_AO_EF disabled, so a board tree has to say which ones it wires up.
+ * This board drives the panel backlight from PWM_EF and PWM_AO_CD -- the two
+ * channels bl_pwm_conf names as pwm_ef and pwmao_cd -- and enables PWM_AO_AB
+ * beside them, as this board requires. Leaving PWM_AO_CD
+ * disabled does not cost one feature quietly: the chip never registers, the
+ * backlight request comes back -EPROBE_DEFER as
+ * "bl error: unable to request PWM_AO_C", and every level change afterwards
+ * logs "bl_set_pwm_normal: invalid bl_pwm_ch". PWM_AO_EF is enabled by the
+ * SoC dtsi and nothing on this board drives it, so it is turned off here the
+ * way this board turns it off.
+ */
+&pwm_ef {
+	status = "okay";
+};
+
+&pwmao_ab {
+	status = "okay";
+};
+
+&pwmao_cd {
+	status = "okay";
+};
+
+&pwmao_ef {
+	status = "disabled";
+};
+
+/*
+ * The PWM consumers that go with the controllers above. Enabling a controller
+ * without its consumer, or the other way round, is what a half-transferred
+ * power tree looks like: vddcpua and vddcpub stay off and cpufreq reports
+ * "freq paramter setting error", while vddnpu keeps asking a disabled
+ * controller for a duty cycle and the NPU probe fails with "voltage init
+ * fail". This board drives both CPU rails from PWM and makes the
+ * NPU rail a fixed 890 mV supply, since PWM_AO_EF is not wired on this board.
+ */
+&vddcpua {
+	status = "okay";
+};
+
+&vddcpub {
+	status = "okay";
+};
+
+&vddnpu {
+	compatible = "regulator-fixed";
+	regulator-min-microvolt = <890000>;
+	regulator-max-microvolt = <890000>;
+	regulator-always-on;
+	/delete-property/ pwms;
+	/delete-property/ max-duty-cycle;
+	/delete-property/ voltage-table;
+	status = "okay";
+};
+
+/*
+ * The CMA shrinker hands reserved CMA back under memory pressure. This
+ * board keeps it off: the display and codec pools here are sized for the
+ * worst case and must stay contiguous, and reclaiming from them is what the
+ * pool exists to prevent.
+ */
+&cma_shrinker {
+	status = "disabled";
+};
+
+/*
+ * PWM_A carries the W2 32.768 kHz sleep clock; wifi_dt.c programs the
+ * double-channel configuration from the SoC dtsi, whose values are the
+ * accepted ones for this board.
+ */
+&pwm_ab {
+	pinctrl-0 = <&pwm_a_pins>;
+	pinctrl-names = "default";
+};
+
+/*
+ * W2 Wi-Fi: host wake on GPIOC_3 (level low, from the SoC dtsi) and the
+ * module power enable on GPIOC_4, as accepted on this board.
+ */
+&aml_wifi {
+	status = "okay";
+	dhd_static_buf;
+	interrupt-gpios = <&gpio GPIOC_3 GPIO_ACTIVE_HIGH>;
+	power_on-gpios = <&gpio GPIOC_4 GPIO_ACTIVE_HIGH>;
+};
+
+/* W2 Bluetooth side of the same module. */
+&aml_bt {
+	status = "okay";
+	reset-gpios = <&gpio GPIOC_2 GPIO_ACTIVE_HIGH>;
+	hostwake-gpios = <&gpio GPIOC_5 GPIO_ACTIVE_HIGH>;
+};
+
+/* Panfrost needs the standard binding for the T7C ACE-Lite path. */
+/*
+ * USB. The SoC dtsi carries every node of this block with status "disable"
+ * and, on the two DRD controllers, no compatible at all -- so nothing binds
+ * and the board has no USB whatever. The statuses and the three missing
+ * properties below are the board's own:
+ *
+ *   crg2drd  gets "amlogic, crg-drd"       -- the dual-role port
+ *   crg3drd  gets "amlogic, crg-host-drd"  -- host only
+ *   crg21otg gets controller-type 1, crg20otg 3
+ *
+ * Which of the pair is enabled is fixed by the board: the OTG block and the
+ * gadget controller on fe03a000/fde00000 stay off, their counterparts on
+ * fe03a020/fdd00000 come up. portnum is a board property and is not in the
+ * dtsi at all.
+ */
+&crg_phy_20 {
+	status = "okay";
+	portnum = <1>;
+};
+
+&crg_phy_21 {
+	status = "okay";
+	portnum = <1>;
+};
+
+&crg3_phy_20 {
+	status = "okay";
+	portnum = <1>;
+};
+
+&crg3_phy_21 {
+	status = "okay";
+	portnum = <0>;
+};
+
+&crg20_otg {
+	status = "disabled";
+	controller-type = <3>;
+};
+
+&crg21_otg {
+	status = "okay";
+	controller-type = <1>;
+};
+
+&crg2_drd {
+	compatible = "amlogic, crg-drd";
+	status = "okay";
+};
+
+&crg3_drd {
+	compatible = "amlogic, crg-host-drd";
+	status = "okay";
+};
+
+&crg_udc_3 {
+	status = "disabled";
+};
+
+&crg_udc_2 {
+	status = "okay";
+};
+
+/*
+ * The NPU rail. The SoC dtsi already describes the ADLA itself completely --
+ * registers, SRAM, interrupt, the whole ANAKIN clock chain, r2p0 and smmu --
+ * and reserved-memory above already carries its 384 MiB pool, so the board's
+ * only remaining job is the supply. On this design it is a fixed 0.89 V rail;
+ * the T7 reference drives the same rail from PWM_AO_F, which is where the
+ * node name comes from; it is described here as a
+ * fixed regulator rather than bringing up the PWM one.
+ */
+&{/} {
+	vddnpu: pwmao_f-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vddnpu";
+		regulator-min-microvolt = <890000>;
+		regulator-max-microvolt = <890000>;
+		regulator-always-on;
+		status = "okay";
+	};
+};
+
+&adla {
+	vddnpu-supply = <&vddnpu>;
+};
+
+/*
+ * The camera: one OV13B10 on i2c4, four MIPI lanes into csiphy0, through the
+ * adapter and the ISP.
+ *
+ * The SoC dtsi brings up camera0, camera2 and the CSI/adapter/ISP blocks with
+ * no board wiring, and amlcam then probes a pipeline that has no sensor at the
+ * end of it: its first register access is refused by the firmware and the
+ * kernel takes an asynchronous SError at about 6.7 s. What stops that is not
+ * the status flags but the endpoint link below -- the sensor node and the
+ * csiphy0 port that name each other are what make this a described pipeline
+ * rather than a dangling one. camera2 and csiphy2 stay off because there is no
+ * second camera on this board.
+ *
+ * The mclk chain is the vendor's: MCLK_0 off its own PLL, with the selector
+ * and predivider named so the sensor driver can rate-set the whole chain, and
+ * the crystal as the last parent. Those four indices were read back from the
+ * decompiled DTB and match the symbols here exactly (375, 372, 374, 31).
+ */
+&i2c4 {
+	ov13b10: sensor0@36 {
+		compatible = "amlogic, sensor";
+		status = "okay";
+		index = <0>;
+		reg = <0x36>;
+		clocks = <&clkc CLKID_MCLK_0>,
+			 <&clkc CLKID_MCLK_0_SEL>,
+			 <&clkc CLKID_MCLK_0_PRE>,
+			 <&clkc CLKID_MCLK_PLL>,
+			 <&xtal>;
+		clock-names = "mclk", "mclk_sel", "mclk_pre", "mclk_p", "mclk_x";
+		pwdn-gpios = <&gpio GPIOY_14 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio GPIOY_18 GPIO_ACTIVE_HIGH>;
+
+		port {
+			ov13b10_ep: ov13b10 {
+				data-lanes = <0 1 2 3>;
+				link-frequencies = /bits/ 64 <1080000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
+&camera0 {
+	status = "okay";
+};
+
+&camera2 {
+	status = "disabled";
+};
+
+&csiphy0 {
+	status = "okay";
+
+	port {
+		csiphy0_ep: endpoint {
+			status = "okay";
+			clock-lanes = <4>;
+			data-lanes = <0 1 2 3>;
+			remote-endpoint = <&ov13b10_ep>;
+		};
+	};
+};
+
+&csiphy2 {
+	status = "disabled";
+};
+
+&adapter0 {
+	status = "okay";
+};
+
+&isp0 {
+	status = "okay";
+};
