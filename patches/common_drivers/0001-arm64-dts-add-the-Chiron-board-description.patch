+/*
+ * Chiron panel, backlight and PWM description.
+ *
+ * Values are the hardware-accepted ones for this board's panel. The
+ * board ships one of three Himax HX83102E 1200x1920 MIPI panels
+ * with identical timing and different init sequences; the kernel selects one
+ * with panel_type= on the command line.
+ */
+
+&periphs_pinctrl {
+	/* Referenced by the lcd node below; the SoC dtsi defines only the "on"
+	 * variants. The panel is MIPI, so these vbyone/edp states are never
+	 * selected, but the driver requires every named state to resolve. */
+	lcd_vbyone_a_off_pins: lcd_vbyone_a_off_pin {
+		mux {
+			groups = "GPIOY_10","GPIOY_12";
+			function = "gpio_periphs";
+			input-enable;
+		};
+	};
+
+	lcd_edp_a_off_pins: lcd_edp_a_off_pin {
+		mux {
+			groups = "GPIOY_10";
+			function = "gpio_periphs";
+			input-enable;
+		};
+	};
+};
+
+/* PWM_AO_C drives the backlight; PWM_F is the second bl_pwm_conf channel. */
+&pwmao_cd {
+	status = "okay";
+};
+
+&pwm_ef {
+	status = "okay";
+};
+
