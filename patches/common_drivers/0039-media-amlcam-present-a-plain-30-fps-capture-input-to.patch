From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chiron Builder <builder@chiron.local>
Date: Fri, 28 Aug 2026 19:50:02 +0000
Subject: [PATCH 39/44] media: amlcam: present a plain 30 fps capture input to
 V4L2 clients

Generic V4L2 clients query the input index and frame interval before they
will open a node. The vendor driver left both unanswered, so browsers and
other stock clients rejected the camera outright.

Validated on
this board.
---
 drivers/amlisp/amlcam/cam_common/aml_video.c | 109 +++++++++++++++++++
 1 file changed, 109 insertions(+)

diff --git a/drivers/amlisp/amlcam/cam_common/aml_video.c b/drivers/amlisp/amlcam/cam_common/aml_video.c
index 2f80eca32..2343abdae 100644
--- a/drivers/amlisp/amlcam/cam_common/aml_video.c
+++ b/drivers/amlisp/amlcam/cam_common/aml_video.c
@@ -337,12 +337,121 @@ static int video_ioctl_dqbuf(struct file *file, void *priv, struct v4l2_buffer *
 	return rtn;
 }
 
+static int video_enum_input(struct file *file, void *fh,
+			    struct v4l2_input *input)
+{
+	if (input->index)
+		return -EINVAL;
+
+	strscpy(input->name, "Camera", sizeof(input->name));
+	input->type = V4L2_INPUT_TYPE_CAMERA;
+	return 0;
+}
+
+static int video_g_input(struct file *file, void *fh, unsigned int *input)
+{
+	*input = 0;
+	return 0;
+}
+
+static int video_s_input(struct file *file, void *fh, unsigned int input)
+{
+	return input ? -EINVAL : 0;
+}
+
+static int video_g_parm(struct file *file, void *fh,
+			struct v4l2_streamparm *parm)
+{
+	struct aml_video *video = video_drvdata(file);
+	struct v4l2_captureparm *capture = &parm->parm.capture;
+
+	if (parm->type != video->type)
+		return -EINVAL;
+
+	memset(capture, 0, sizeof(*capture));
+	capture->capability = V4L2_CAP_TIMEPERFRAME;
+	capture->timeperframe.numerator = 1;
+	capture->timeperframe.denominator = 30;
+	capture->readbuffers = video->min_buffer_count;
+	return 0;
+}
+
+static int video_s_parm(struct file *file, void *fh,
+			struct v4l2_streamparm *parm)
+{
+	/* The OV13B10 production mode and ISP service both run at 30 fps. */
+	return video_g_parm(file, fh, parm);
+}
+
+static int video_enum_framesizes(struct file *file, void *fh,
+				 struct v4l2_frmsizeenum *fsize)
+{
+	static const struct v4l2_frmsize_discrete sizes[] = {
+		{ 320, 240 },
+		{ 640, 360 },
+		{ 640, 480 },
+		{ 1280, 720 },
+		{ 1920, 1080 },
+		{ 3840, 2160 },
+		{ 4208, 3120 },
+	};
+	struct aml_video *video = video_drvdata(file);
+	unsigned int i;
+
+	if (fsize->index >= ARRAY_SIZE(sizes))
+		return -EINVAL;
+	for (i = 0; i < video->fmt_cnt; i++) {
+		if (fsize->pixel_format == video->format[i].fourcc)
+			break;
+	}
+	if (i == video->fmt_cnt)
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_DISCRETE;
+	fsize->discrete = sizes[fsize->index];
+	return 0;
+}
+
+static int video_enum_frameintervals(struct file *file, void *fh,
+				     struct v4l2_frmivalenum *fival)
+{
+	struct v4l2_frmsizeenum fsize = {
+		.index = 0,
+		.pixel_format = fival->pixel_format,
+	};
+	unsigned int index;
+
+	if (fival->index)
+		return -EINVAL;
+
+	for (index = 0; ; index++) {
+		fsize.index = index;
+		if (video_enum_framesizes(file, fh, &fsize))
+			return -EINVAL;
+		if (fsize.discrete.width == fival->width &&
+		    fsize.discrete.height == fival->height)
+			break;
+	}
+
+	fival->type = V4L2_FRMIVAL_TYPE_DISCRETE;
+	fival->discrete.numerator = 1;
+	fival->discrete.denominator = 30;
+	return 0;
+}
+
 static const struct v4l2_ioctl_ops aml_v4l2_ioctl_ops = {
 	.vidioc_querycap		= video_querycap,
+	.vidioc_enum_input		= video_enum_input,
+	.vidioc_g_input			= video_g_input,
+	.vidioc_s_input			= video_s_input,
 	.vidioc_enum_fmt_vid_cap	= video_enum_fmt,
+	.vidioc_enum_framesizes		= video_enum_framesizes,
+	.vidioc_enum_frameintervals	= video_enum_frameintervals,
 	.vidioc_g_fmt_vid_cap		= video_get_fmt,
 	.vidioc_s_fmt_vid_cap		= video_set_fmt,
 	.vidioc_try_fmt_vid_cap		= video_try_fmt,
+	.vidioc_g_parm			= video_g_parm,
+	.vidioc_s_parm			= video_s_parm,
 	.vidioc_reqbufs			= vb2_ioctl_reqbufs,
 	.vidioc_querybuf		= vb2_ioctl_querybuf,
 	.vidioc_qbuf			= video_ioctl_qbuf,
