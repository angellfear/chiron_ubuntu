set -euo pipefail
root=$(git rev-parse --show-toplevel)
command -v pwsh >/dev/null 2>&1 || {
    echo "pwsh is required for the repository policy check" >&2
    exit 1
}
pwsh -NoProfile -File "$root/scripts/check-repository.ps1" -Root "$root"
